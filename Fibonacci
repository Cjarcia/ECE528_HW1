
#include <stdio.h>
#include <stdint.h>
#include <inttypes.h>

// F(93) is the last one that fits in 64 bits unsigned
#define MAX_N 93

int main(void)
{
    int n;
    uint64_t prev = 0;   // F(i-2)
    uint64_t curr = 1;   // F(i-1)
    uint64_t next;

    printf("ECE 528/L - Cristian Garcia - HW1\n");
    printf("Enter N (2 or greater): ");

    if (scanf("%d", &n) != 1 || n < 2) {
        printf("Invalid input. Please enter an integer that is 2 or greater.\n");
        return 1;
    }
    if (n > MAX_N) {
        printf("Invalid input. N has to be %d or less or the result overflows.\n", MAX_N);
        return 1;
    }

    printf("Fibonacci sequence up to %d terms:\n", n);
    printf("%" PRIu64 " %" PRIu64, prev, curr);

    for (int i = 2; i <= n; i++) {
        next = prev + curr;
        prev = curr;
        curr = next;
        printf(" %" PRIu64, curr);
    }
    printf("\n");

    printf("F(%d) = %" PRIu64 "\n", n, curr);

    return 0;
}